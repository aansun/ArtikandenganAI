# Book translator agent worker: translate_book.py --watch, driven by the claude CLI.
# agy (Antigravity) is not installed here: it has no documented headless sign-in or
# Linux package, so the worker translates with Claude only (see docs/BOOK_AGENT.md).
# Build from the repository root:
#   docker build -f deployment/Dockerfile.agent -t book-agent .
FROM node:22-bookworm-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/home/agent \
    BOOKS_DIR=/data

RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @anthropic-ai/claude-code \
    && useradd --create-home --home-dir /home/agent --shell /bin/bash agent \
    && mkdir -p /data/inbox && chown -R agent:agent /data /home/agent

WORKDIR /app
COPY requirements.txt .
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt
ENV PATH="/opt/venv/bin:$PATH"

COPY src/ /app/src/
COPY translate.py translate_book.py /app/
RUN chown -R agent:agent /app

USER agent
# The books library: inbox/, one folder per book (source/, translation/, book.json,
# glossary, checkpoints) and INDEX.md. Everything that must survive a restart.
VOLUME /data
WORKDIR /data

# Credentials come from the environment (ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN).
CMD ["python", "/app/translate_book.py", "--watch", "--translate-provider", "claude-cli"]
